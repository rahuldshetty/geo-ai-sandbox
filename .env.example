# Geo-AI Harness — environment configuration
#
# Copy this file to `.env` and fill in your provider API key.
# `.env` is git-ignored; never commit real keys.

# Provider API key (standard env var read by pydantic-ai):
OPENAI_API_KEY=

# Optional: custom OpenAI-compatible endpoint (base URL).
# Leave empty to use OpenAI's default endpoint.
# Examples: Azure OpenAI, LiteLLM, vLLM, OpenRouter, or a local proxy.
#   OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_BASE_URL=

# Optional: override the default model.
# Formats: openai:gpt-4o, anthropic:claude-sonnet-4-5,
#          google-gla:gemini-2.5-pro, ollama:llama3.1
GEOAI_MODEL=openai:gpt-4o
