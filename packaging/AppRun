#!/bin/sh
# AppRun: entry point exec'd by the AppImage runtime.
HERE="$(dirname "$(readlink -f "$0")")"
# logfire's pydantic plugin patches pydantic internals via inspect.getsource,
# which cannot resolve in a frozen bundle and aborts at startup. The harness
# uses no logfire instrumentation, so switch the plugin off.
export LOGFIRE_PYDANTIC_RECORD=off
exec "$HERE/usr/bin/spatial-intelligence" "$@"
