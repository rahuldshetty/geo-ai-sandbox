# Per-Dockerfile ignore (BuildKit reads <Dockerfile>.dockerignore next to it).
# Patterns are relative to the build context root.
#
# Keep user data, secrets, scratch dirs, and build junk out of the build context.
.git
.venv
venv
env
workspaces
dist
build
build-pyi
AppDir
hack
.pytest_cache
*.egg-info
**/__pycache__
*.py[codz]
.env
.env.*
opencode-go.env
settings.json
ARCHITECTURE.local.md

# The Marked bundle is fetched inside the image at its pinned version, so a
# host copy must never decide what ships.
spatial_intelligence/web/vendor
